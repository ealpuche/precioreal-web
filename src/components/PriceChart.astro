---
import type { CatalogSeriesPoint } from "../contracts/catalog";

interface Props {
  series: CatalogSeriesPoint[];
  typical: string;
  min: string;
  max: string;
}
const { series, typical, min, max } = Astro.props;

const W = 1000,
  H = 320,
  L = 64,
  R = 16,
  T = 16,
  B = 36;
const prices = series.map(([, p]) => Number(p));
const dates = series.map(([d]) => new Date(d).getTime());

const yMinRaw = Math.min(...prices, Number(min));
const yMaxRaw = Math.max(...prices, Number(max));
const pad = (yMaxRaw - yMinRaw) * 0.08 || yMaxRaw * 0.1 || 1;
const yMin = Math.max(0, yMinRaw - pad);
const yMax = yMaxRaw + pad;

const xMin = dates.length ? Math.min(...dates) : 0;
const xMax = dates.length ? Math.max(...dates) : 1;
const xSpan = xMax - xMin || 1;

const x = (t: number) => L + ((t - xMin) / xSpan) * (W - L - R);
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);

let stepPath = "";
series.forEach(([d, p], i) => {
  const px = x(new Date(d).getTime());
  const py = y(Number(p));
  stepPath += i === 0 ? `M ${px} ${py}` : ` H ${px} V ${py}`;
});

const gridValues = [0, 0.25, 0.5, 0.75, 1].map((f) => yMin + (yMax - yMin) * f);
const typicalY = y(Number(typical));
const lastPoint = series[series.length - 1];
---

{
  series.length === 0 ? (
    <p class="empty">Sin puntos de historial disponibles.</p>
  ) : (
    <div class="figure">
      <svg
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label="Historial de precio"
      >
        {gridValues.map((v) => (
          <>
            <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="var(--line)" />
            <text
              x={L - 10}
              y={y(v) + 4}
              text-anchor="end"
              font-family="JetBrains Mono"
              font-size="11"
              fill="var(--muted)"
            >
              {Math.round(v).toLocaleString("es-MX")}
            </text>
          </>
        ))}
        <line
          x1={L}
          x2={W - R}
          y1={typicalY}
          y2={typicalY}
          stroke="var(--muted)"
          stroke-dasharray="5 5"
          stroke-width="1.5"
        />
        <path d={stepPath} fill="none" stroke="var(--green)" stroke-width="2" />
        {lastPoint && (
          <circle
            cx={x(new Date(lastPoint[0]).getTime())}
            cy={y(Number(lastPoint[1]))}
            r="5"
            fill="var(--bg)"
            stroke="var(--green)"
            stroke-width="2"
          />
        )}
      </svg>
      <div class="legend">
        <span>
          <i class="dot green" />
          precio observado
        </span>
        <span>
          <i class="dot dashed" />
          precio habitual
        </span>
      </div>
    </div>
  )
}

<style>
  .figure {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 4px;
    padding: 20px 20px 12px;
  }
  .figure svg {
    width: 100%;
    height: 320px;
    display: block;
  }
  .legend {
    display: flex;
    gap: 20px;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 14px;
    height: 2px;
    vertical-align: middle;
    margin-right: 6px;
  }
  .dot.green {
    background: var(--green);
  }
  .dot.dashed {
    border-top: 2px dashed var(--muted);
  }
  .empty {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 14px;
  }
</style>
