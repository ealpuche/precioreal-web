---
import type { CatalogSeriesPoint } from "../contracts/catalog";
import { TZ } from "../lib/tz";
import { monthTicks } from "../lib/chart-ticks";
import { buildChartStamp } from "../lib/freshness";
import { yAxisMargin } from "../lib/chart-layout";

interface Props {
  series: CatalogSeriesPoint[];
  typical?: string;
  min?: string;
  max?: string;
  /** `generated_at` de la ficha: fecha en que el productor la escribió por última vez. */
  generatedAt?: string;
}
const { series, typical, min, max, generatedAt } = Astro.props;

// 640 de ancho y no 1000: el SVG escala al contenedor, y con 1000 unidades las etiquetas de
// 11 salían a ~4 px en un teléfono de 390 px (auditoría V0, #40). Con 640 y fuente de 17 se
// leen a ~9.5 px en móvil y a ~17 px en la columna de escritorio.
const W = 640,
  H = 340,
  R = 12,
  T = 16,
  B = 40;
const FS = 17;
const prices = series.map(([, p]) => Number(p));
const dates = series.map(([d]) => new Date(d).getTime());

const yMinCandidates = [...prices];
if (min !== undefined) yMinCandidates.push(Number(min));
const yMaxCandidates = [...prices];
if (max !== undefined) yMaxCandidates.push(Number(max));

const yMinRaw = Math.min(...yMinCandidates);
const yMaxRaw = Math.max(...yMaxCandidates);
const pad = (yMaxRaw - yMinRaw) * 0.08 || yMaxRaw * 0.1 || 1;
const yMin = Math.max(0, yMinRaw - pad);
const yMax = yMaxRaw + pad;

const xMin = dates.length ? Math.min(...dates) : 0;
const xMax = dates.length ? Math.max(...dates) : 1;
const xSpan = xMax - xMin || 1;

// Mismas etiquetas que dibuja el eje: el margen se calcula con ellas, no con un ancho fijo.
const yLabels = [0, 0.25, 0.5, 0.75, 1].map((f) =>
  Math.round(yMin + (yMax - yMin) * f).toLocaleString("es-MX"),
);
const L = yAxisMargin(yLabels, FS);

const x = (t: number) => L + ((t - xMin) / xSpan) * (W - L - R);
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);

let stepPath = "";
series.forEach(([d, p], i) => {
  const px = x(new Date(d).getTime());
  const py = y(Number(p));
  stepPath += i === 0 ? `M ${px} ${py}` : ` H ${px} V ${py}`;
});

const gridValues = [0, 0.25, 0.5, 0.75, 1].map((f) => yMin + (yMax - yMin) * f);
const typicalY = typical !== undefined ? y(Number(typical)) : null;
const lastPoint = series[series.length - 1];

// Último punto de la serie que toca el mínimo publicado: el número es el del productor, la
// posición sale de la serie. Si no coincide ninguno, no se marca (no se inventa la fecha).
const minValue = min !== undefined ? Number(min) : NaN;
let minPoint: { x: number; y: number } | null = null;
// Si el mínimo es el último punto, el punto de "hoy" ya lo marca: dibujar los dos encima
// dejaba una leyenda "mínimo" sin marca visible.
for (let i = series.length - 1; i >= 0 && Number.isFinite(minValue); i--) {
  if (Number(series[i][1]) === minValue) {
    if (i < series.length - 1) minPoint = { x: x(dates[i]), y: y(minValue) };
    break;
  }
}

// Ticks en fronteras de mes calendario, no "hasta 6 espaciados por índice" como especificaba
// el PQ 05: con series de longitud irregular, el espaciado por índice deja etiquetas en
// fechas arbitrarias ("14 jun") mientras que las fronteras de mes dan un eje legible y
// estable. Desviación deliberada respecto a la especificación, declarada aquí para que no
// parezca que ambas coinciden.
const xTicks =
  dates.length > 1
    ? monthTicks(xMin, xMax)
        .map((tick) => ({ x: x(tick.t), label: tick.label }))
        .filter((tick) => tick.x >= L + 20 && tick.x <= W - R - 20)
    : [];

// Puntos para interacción de hover
const hoverPoints = series.map(([d, p]) => {
  const dt = new Date(d);
  const dateStr = dt.toLocaleDateString("es-MX", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: TZ,
  });
  const priceNum = Number(p).toLocaleString("es-MX", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  return {
    px: x(dt.getTime()),
    py: y(Number(p)),
    date: dateStr,
    price: `$${priceNum}`,
  };
});

const stamp = buildChartStamp(generatedAt);
---

{
  series.length === 0 ? (
    <p class="empty">Sin puntos de historial disponibles.</p>
  ) : (
    <div class="figure" data-chart-container>
      <div class="chart-wrapper">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Historial de precio"
        >
          {gridValues.map((v) => (
            <>
              <line
                x1={L}
                x2={W - R}
                y1={y(v)}
                y2={y(v)}
                stroke="var(--line)"
              />
              <text
                x={L - 10}
                y={y(v) + 4}
                text-anchor="end"
                font-family="IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
                font-size={FS}
                fill="var(--muted)"
              >
                {Math.round(v).toLocaleString("es-MX")}
              </text>
            </>
          ))}
          {xTicks.map((tick) => (
            <>
              <line
                x1={tick.x}
                x2={tick.x}
                y1={T}
                y2={H - B}
                stroke="var(--line)"
                stroke-dasharray="2 2"
              />
              <text
                x={tick.x}
                y={H - B + 26}
                text-anchor="middle"
                font-family="IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
                font-size={FS}
                fill="var(--muted)"
              >
                {tick.label}
              </text>
            </>
          ))}
          {typicalY !== null && (
            <line
              x1={L}
              x2={W - R}
              y1={typicalY}
              y2={typicalY}
              stroke="var(--muted)"
              stroke-dasharray="5 5"
              stroke-width="1.5"
            />
          )}
          {/* En la franja baja y no en el centro: verificado en el preview que ahí la línea
              de precio la atravesaba, compitiendo con lo que hay que leer y perdiéndose entre
              los trazos a la vez. Sigue siendo irrecortable — recortarla implica cortar el eje
              X y las etiquetas de mes. La posición es una fracción fija, no calculada: en una
              serie que suba hacia el final la línea pasará por aquí. Si eso estorba en varias
              formas de gráfica, la alternativa es una franja diagonal repetida que no dependa
              de los datos. */}
          <text
            x={(L + W - R) / 2}
            y={T + (H - T - B) * 0.78}
            text-anchor="middle"
            dominant-baseline="middle"
            font-family="IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
            font-size="34"
            font-weight="700"
            fill="var(--muted)"
            opacity="0.09"
            style="pointer-events: none; user-select: none;"
          >
            precioreal.mx
          </text>
          <path
            d={stepPath}
            fill="none"
            stroke="var(--text)"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
          {minPoint && (
            <circle
              cx={minPoint.x}
              cy={minPoint.y}
              r="6"
              fill="var(--down)"
              stroke="var(--surface)"
              stroke-width="2"
            />
          )}
          {lastPoint && (
            <circle
              cx={x(new Date(lastPoint[0]).getTime())}
              cy={y(Number(lastPoint[1]))}
              r="7"
              fill="var(--accent)"
              stroke="var(--surface)"
              stroke-width="2.5"
            />
          )}
          <text
            x={W - R}
            y={T + 12}
            text-anchor="end"
            font-family="IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, monospace"
            font-size="14"
            fill="var(--muted)"
            opacity="0.8"
            style="pointer-events: none; user-select: none;"
          >
            {stamp}
          </text>
          <g class="hover-elements" style="display: none;">
            <line
              class="hover-line"
              x1="0"
              x2="0"
              y1={T}
              y2={H - B}
              stroke="var(--muted)"
              stroke-dasharray="3 3"
              stroke-width="1"
            />
            <circle
              class="hover-dot"
              cx="0"
              cy="0"
              r="6"
              fill="var(--accent)"
              stroke="var(--surface)"
              stroke-width="2"
            />
          </g>
        </svg>
        {/* Los div internos van self-closing porque prettier-plugin-astro colapsa así todo
            elemento sin hijos dentro de una expresión JSX, y `npm run check` corre
            `prettier --check`: escribirlos con cierre explícito rompe el CI. Astro compila
            ambos a `<div ...></div>` en el bundle, verificado en dist/_worker.js (CR PR #7
            ronda 4, Copilot). */}
        <div class="chart-tooltip" style="display: none;">
          <div class="tooltip-price" />
          <div class="tooltip-date" />
        </div>
        <script
          type="application/json"
          data-chart-points
          set:html={JSON.stringify(
            hoverPoints.map((h) => [h.px, h.py, h.date, h.price]),
          )}
        />
      </div>
      <div class="legend">
        <span>
          <i class="dot line" />
          precio observado
        </span>
        {minPoint && (
          <span>
            <i class="dot min" />
            mínimo
          </span>
        )}
        {typical !== undefined && (
          <span>
            <i class="dot dashed" />
            precio habitual
          </span>
        )}
      </div>
    </div>
  )
}

<script>
  import { nearestPointIndex } from "../lib/chart-hover";

  interface HoverPoint {
    px: number;
    py: number;
    date: string;
    price: string;
  }

  const container = document.querySelector("[data-chart-container]");
  if (container) {
    const svg = container.querySelector("svg");
    const tooltip = container.querySelector(
      ".chart-tooltip",
    ) as HTMLElement | null;
    const hoverGroup = container.querySelector(
      ".hover-elements",
    ) as SVGElement | null;
    const hoverLine = container.querySelector(
      ".hover-line",
    ) as SVGLineElement | null;
    const hoverDot = container.querySelector(
      ".hover-dot",
    ) as SVGCircleElement | null;
    const tooltipPrice = container.querySelector(
      ".tooltip-price",
    ) as HTMLElement | null;
    const tooltipDate = container.querySelector(
      ".tooltip-date",
    ) as HTMLElement | null;

    if (
      svg &&
      tooltip &&
      hoverGroup &&
      hoverLine &&
      hoverDot &&
      tooltipPrice &&
      tooltipDate
    ) {
      // Tuplas en un bloque JSON, no un atributo: en un atributo cada comilla se escapa a
      // &quot; (6 bytes por 1), y con el umbral de ~2000 puntos del contrato eso son cientos
      // de KB extra en la página de adquisición orgánica (CR PR #7, H6).
      const rawPoints = container.querySelector(
        "[data-chart-points]",
      )?.textContent;
      const points: HoverPoint[] = rawPoints
        ? (JSON.parse(rawPoints) as [number, number, string, string][]).map(
            ([px, py, date, price]) => ({ px, py, date, price }),
          )
        : [];

      if (points.length > 0) {
        svg.addEventListener("mousemove", (e) => {
          const rect = svg.getBoundingClientRect();
          // Del viewBox real y no de constantes: el servidor calcula las coordenadas con W/H
          // del frontmatter, y un cambio ahí desalineaba el tooltip en silencio porque el
          // cliente seguía dividiendo entre los valores viejos (CR PR #7 ronda 4, Copilot).
          const vb = svg.viewBox.baseVal;
          const svgX = ((e.clientX - rect.left) / rect.width) * vb.width;
          const idx = nearestPointIndex(points, svgX);
          const pt = points[idx];

          hoverGroup.style.display = "block";
          hoverLine.setAttribute("x1", String(pt.px));
          hoverLine.setAttribute("x2", String(pt.px));
          hoverDot.setAttribute("cx", String(pt.px));
          hoverDot.setAttribute("cy", String(pt.py));

          tooltipPrice.textContent = pt.price;
          tooltipDate.textContent = pt.date;
          tooltip.style.display = "block";

          tooltip.style.left = `${(pt.px / vb.width) * 100}%`;
          tooltip.style.top = `${(pt.py / vb.height) * 100}%`;
        });

        svg.addEventListener("mouseleave", () => {
          hoverGroup.style.display = "none";
          tooltip.style.display = "none";
        });
      }
    }
  }
</script>

<style>
  .figure {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-3) var(--sp-3);
  }
  .chart-wrapper {
    position: relative;
    width: 100%;
  }
  .figure svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .chart-tooltip {
    position: absolute;
    pointer-events: none;
    transform: translate(-50%, -120%);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 6px 10px;
    font-family: var(--mono);
    z-index: 10;
    white-space: nowrap;
  }
  .tooltip-price {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .tooltip-date {
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
  }
  .legend {
    display: flex;
    gap: 20px;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 14px;
    height: 2px;
    vertical-align: middle;
    margin-right: 6px;
  }
  .dot.line {
    background: var(--text);
  }
  .dot.min {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--down);
  }
  .dot.dashed {
    border-top: 2px dashed var(--muted);
  }
  .empty {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 14px;
  }
</style>
