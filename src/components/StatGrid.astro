---
interface Stat {
  label: string;
  value: string;
  tone?: "default" | "good" | "warn";
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<dl class="stats">
  {
    stats.map((s) => (
      <div class="stat">
        <dt>{s.label}</dt>
        <dd class:list={["num", s.tone ?? "default"]}>{s.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }
  .stat {
    background: var(--surface);
    padding: var(--sp-3) var(--sp-4);
  }
  dt {
    font-size: var(--fs-12);
    color: var(--muted);
  }
  dd {
    margin: 2px 0 0;
    font-size: var(--fs-18);
    font-weight: 500;
    color: var(--text);
  }
  dd.good {
    color: var(--down);
  }
  dd.warn {
    color: var(--up);
  }
</style>
