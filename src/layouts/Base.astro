---
import "../styles/tokens.css";
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import { CONTACT_EMAIL, COBERTURA, TELEGRAM_URL } from "../lib/site";
import { gaInitScript, gaMeasurementId } from "../lib/analytics";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PrecioReal.mx — ¿Ese descuento es real?",
  description = "Consulta el historial de precios de un producto de Cyberpuerta antes de comprar y sabe si el descuento es real.",
} = Astro.props;

const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const beacon =
  typeof beaconToken === "string" && beaconToken.trim() !== ""
    ? JSON.stringify({ token: beaconToken.trim() })
    : null;

// Google Analytics 4 (#64): solo con un ID válido, que existe únicamente en Production.
const gaId = gaMeasurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f4f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    {
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={beacon}
        />
      )
    }
    {
      gaId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          />
          <script is:inline set:html={gaInitScript(gaId)} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand" aria-label="PrecioReal.mx, inicio">
          <Wordmark />
        </a>
        <nav aria-label="Principal" class="links">
          <a href="/buscar">Buscar</a>
          <a href="/datos">Para negocios</a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container foot">
        <div class="about">
          <Wordmark size="sm" />
          <p>
            Historial de precios de {COBERTURA.tienda}, actualizado a diario.
            Datos, no promesas.
          </p>
        </div>
        <nav aria-label="Pie de página" class="foot-links">
          <a href="/buscar">Buscar un producto</a>
          <a href="/datos">Datos para negocios</a>
          <a href={TELEGRAM_URL} rel="noopener" target="_blank"
            >Ofertas en Telegram</a
          >
          <a href={`mailto:${CONTACT_EMAIL}`}>Contacto</a>
          <a href="/datos#medicion">Qué medimos</a>
        </nav>
        <p class="legal">
          Los precios provienen de las páginas públicas de cada tienda. Las
          marcas pertenecen a sus dueños. PrecioReal.mx no vende productos ni
          cobra comisiones por enlaces.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--sp-4);
    top: var(--sp-2);
    z-index: 10;
    background: var(--surface);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
  }
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 64px;
  }
  .brand {
    text-decoration: none;
    color: var(--text);
  }
  .links {
    display: flex;
    gap: var(--sp-4);
    font-size: var(--fs-14);
    font-weight: 600;
  }
  .links a {
    color: var(--text);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  .site-footer {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .foot {
    display: grid;
    gap: var(--sp-5);
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-6);
  }
  @media (min-width: 720px) {
    .foot {
      grid-template-columns: 1fr auto;
    }
    .legal {
      grid-column: 1 / -1;
    }
  }
  .about {
    display: grid;
    gap: var(--sp-3);
    max-width: 44ch;
  }
  .about p,
  .legal {
    color: var(--muted);
    font-size: var(--fs-14);
  }
  .foot-links {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-14);
    align-content: start;
  }
  .legal {
    font-size: var(--fs-12);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-4);
  }
</style>
