---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
}

const {
  title = "PrecioReal — ¿Ese descuento es real?",
  description = "Rastreamos los precios de hardware en México y detectamos descuentos falsos antes de Buen Fin.",
  showNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230B0E14'/%3E%3Crect x='8' y='8' width='16' height='16' fill='%2322FF88' rx='2'/%3E%3C/svg%3E"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      showNav && (
        <nav class="site-nav">
          <a href="/" class="site-nav-brand">
            PrecioReal<span class="cursor">_</span>
          </a>
          <a href="/buscar" class="site-nav-link">
            Buscar producto
          </a>
        </nav>
      )
    }
    <slot />
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 24px;
    border-bottom: 1px solid var(--line);
    font-family: var(--sans);
  }
  .site-nav-brand {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    text-decoration: none;
  }
  .site-nav-brand .cursor {
    color: var(--green);
    font-family: var(--mono);
  }
  .site-nav-link {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--green);
    text-decoration: none;
  }
  .site-nav-link:hover {
    text-decoration: underline;
  }
</style>
