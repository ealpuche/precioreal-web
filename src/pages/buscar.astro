---
export const prerender = false;

import Base from "../layouts/Base.astro";
import { resolveProductUrl } from "../lib/catalog";
import {
  looksLikeUrl,
  normalizeProductUrl,
  tiendaNoPublicada,
} from "../lib/product-url";
import { SKU_RE } from "../lib/sku";
import "../styles/tokens.css";

const q = (Astro.url.searchParams.get("q") ?? "").trim();
let error: string | null = null;

if (q) {
  if (SKU_RE.test(q) && !looksLikeUrl(q)) {
    return Astro.redirect(`/cyberpuerta/${encodeURIComponent(q)}`, 302);
  }
  const normalized = normalizeProductUrl(q);
  if (!normalized) {
    error =
      "Eso no parece un código de producto ni un enlace. Revisa lo que pegaste.";
  } else {
    const tiendaPendiente = tiendaNoPublicada(normalized);
    if (tiendaPendiente) {
      error = `Rastreamos ${tiendaPendiente}, pero su historial todavía no está disponible en el sitio. Por ahora solo puedes consultar Cyberpuerta.`;
    } else if (!normalized.startsWith("cyberpuerta.mx/")) {
      error = "Por ahora solo tenemos historial de Cyberpuerta.";
    } else {
      const resolved = await resolveProductUrl("cyberpuerta", normalized);
      if (resolved.ok) {
        return Astro.redirect(
          `/cyberpuerta/${encodeURIComponent(resolved.sku)}`,
          302,
        );
      }
      error =
        resolved.reason === "upstream_error"
          ? "No pudimos consultar el catálogo en este momento. Intenta de nuevo en un momento."
          : "No encontramos ese producto en nuestro catálogo de Cyberpuerta.";
    }
  }
}
---

<Base title="Buscar producto — PrecioReal" showNav>
  <div class="page">
    <h1>Buscar producto</h1>
    <p class="sub">
      Escribe el código SKU de un producto de Cyberpuerta para ver su historial
      de precio.
    </p>
    <form id="buscar-form" class="form" method="get">
      <input
        type="text"
        id="sku-input"
        name="q"
        value={q}
        placeholder="ej. 010-02551-01 o pega el enlace del producto"
        autocomplete="off"
      />
      <button type="submit" class="btn-primary">Buscar</button>
    </form>
    {
      error && (
        <p id="buscar-error" class="error">
          {error}
        </p>
      )
    }
    <p class="note">
      Puedes escribir el código SKU del producto o pegar el enlace de su página
      en Cyberpuerta.
    </p>
  </div>
</Base>

<style>
  .page {
    max-width: 600px;
    margin: 0 auto;
    padding: 60px 24px;
    font-family: var(--sans);
    color: var(--text);
  }
  h1 {
    color: var(--text-strong);
    font-size: 26px;
    margin: 0 0 8px;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .form {
    display: flex;
    gap: 10px;
  }
  .form input {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 12px 14px;
    color: var(--text-strong);
    font-family: var(--mono);
    font-size: 14px;
  }
  .btn-primary {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    background: var(--green);
    color: var(--bg);
    padding: 12px 20px;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  .error {
    margin-top: 12px;
    color: var(--amber);
    font-size: 13px;
    font-family: var(--mono);
  }
  .note {
    margin-top: 24px;
    color: var(--muted);
    font-size: 12px;
  }
</style>
