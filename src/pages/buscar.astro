---
export const prerender = false;

import Base from "../layouts/Base.astro";
import { resolveProductUrl } from "../lib/catalog";
import {
  hostPertenece,
  normalizeProductUrl,
  tiendaNoPublicada,
} from "../lib/product-url";
import { SKU_RE } from "../lib/sku";
import "../styles/tokens.css";

const q = (Astro.url.searchParams.get("q") ?? "").trim();
let error: string | null = null;

if (q) {
  // Una línea por búsqueda, visible en `wrangler tail` y en Workers Logs. Sin esto, el issue
  // que difiere la optimización de la resolución por URL tendría un disparador imposible de
  // comprobar: "cuando haya dato de uso" no llega solo. Se registran el modo, el desenlace y
  // el tiempo — nunca lo que el usuario pegó, que no aporta a la decisión y sí crearía una
  // retención que habría que justificar.
  const t0 = Date.now();
  let modo = "sku";
  let resultado = "redirigido";

  try {
    // Sin `!looksLikeUrl(q)`: SKU_RE ya excluye `/` y `:`, así que era condición muerta
    // (CR PR #11, H5).
    if (SKU_RE.test(q)) {
      return Astro.redirect(`/cyberpuerta/${encodeURIComponent(q)}`, 302);
    }
    modo = "url";
    const normalized = normalizeProductUrl(q);
    if (!normalized) {
      resultado = "ilegible";
      error =
        "Eso no parece un código de producto ni un enlace. Revisa lo que pegaste.";
    } else {
      const tiendaPendiente = tiendaNoPublicada(normalized);
      if (tiendaPendiente) {
        resultado = "tienda_no_publicada";
        error = `Rastreamos ${tiendaPendiente}, pero su historial todavía no está disponible en el sitio. Por ahora solo puedes consultar Cyberpuerta.`;
      } else if (!hostPertenece(normalized, "cyberpuerta.mx")) {
        resultado = "tienda_desconocida";
        error = "Por ahora solo tenemos historial de Cyberpuerta.";
      } else if (!normalized.includes("/")) {
        resultado = "sin_ruta";
        error =
          "Ese es el enlace de la portada de Cyberpuerta. Pega el de un producto.";
      } else {
        const resolved = await resolveProductUrl("cyberpuerta", normalized);
        if (resolved.ok) {
          return Astro.redirect(
            `/cyberpuerta/${encodeURIComponent(resolved.sku)}`,
            302,
          );
        }
        resultado =
          resolved.reason === "upstream_error"
            ? "error_upstream"
            : "no_encontrado";
        error =
          resolved.reason === "upstream_error"
            ? "No pudimos consultar el catálogo en este momento. Intenta de nuevo en un momento."
            : "No encontramos ese producto en nuestro catálogo de Cyberpuerta.";
      }
    }
  } finally {
    // En `finally` porque los caminos exitosos salen por `return Astro.redirect(...)`: sin
    // esto, justo las búsquedas que funcionan serían las que no se registran.
    console.log(
      JSON.stringify({
        evento: "buscar",
        modo,
        resultado,
        ms: Date.now() - t0,
      }),
    );
  }
}
---

<Base title="Buscar producto — PrecioReal" showNav>
  <div class="page">
    <h1>Buscar producto</h1>
    <p class="sub">
      Escribe el código de un producto o pega el enlace de su página en
      Cyberpuerta.
    </p>
    <form id="buscar-form" class="form" method="get">
      <input
        type="text"
        id="sku-input"
        name="q"
        value={q}
        placeholder="ej. 010-02551-01 o pega el enlace del producto"
        autocomplete="off"
      />
      <button type="submit" class="btn-primary">Buscar</button>
    </form>
    {
      error && (
        <p id="buscar-error" class="error">
          {error}
        </p>
      )
    }
  </div>
</Base>

<style>
  .page {
    max-width: 600px;
    margin: 0 auto;
    padding: 60px 24px;
    font-family: var(--sans);
    color: var(--text);
  }
  h1 {
    color: var(--text-strong);
    font-size: 26px;
    margin: 0 0 8px;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .form {
    display: flex;
    gap: 10px;
  }
  .form input {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 12px 14px;
    color: var(--text-strong);
    font-family: var(--mono);
    font-size: 14px;
  }
  .btn-primary {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    background: var(--green);
    color: var(--bg);
    padding: 12px 20px;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  .error {
    margin-top: 12px;
    color: var(--amber);
    font-size: 13px;
    font-family: var(--mono);
  }
  .note {
    margin-top: 24px;
    color: var(--muted);
    font-size: 12px;
  }
</style>
