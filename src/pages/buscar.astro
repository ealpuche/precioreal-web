---
export const prerender = false;

import Base from "../layouts/Base.astro";
import { logEvent, validateEvent } from "../lib/event";
import { storeEvent } from "../lib/event-store";
import { resolveProductUrl } from "../lib/catalog";
import {
  hostPertenece,
  normalizeProductUrl,
  tiendaNoPublicada,
} from "../lib/product-url";
import { SKU_RE } from "../lib/sku";
import SearchBox from "../components/SearchBox.astro";

const q = (Astro.url.searchParams.get("q") ?? "").trim();
let error: string | null = null;

if (q) {
  // Una línea por búsqueda en la consola del worker (solo en vivo, con `wrangler tail`)
  // y una fila en D1 (#32). Sin esto, el issue
  // que difiere la optimización de la resolución por URL tendría un disparador imposible de
  // comprobar: "cuando haya dato de uso" no llega solo. Se registran el modo, el desenlace y
  // el tiempo — nunca lo que el usuario pegó, que no aporta a la decisión y sí crearía una
  // retención que habría que justificar.
  const t0 = Date.now();
  let modo = "sku";
  let resultado = "redirigido";

  try {
    // Sin `!looksLikeUrl(q)`: SKU_RE ya excluye `/` y `:`, así que era condición muerta
    // (CR PR #11, H5).
    if (SKU_RE.test(q)) {
      return Astro.redirect(`/cyberpuerta/${encodeURIComponent(q)}`, 302);
    }
    modo = "url";
    const normalized = normalizeProductUrl(q);
    if (!normalized) {
      resultado = "ilegible";
      // Casi siempre es un nombre tecleado: el mensaje da la salida en vez de un callejón
      // (auditoría V0, #40). La búsqueda por nombre es #15.
      error =
        "Eso no parece un código ni un enlace. Todavía no buscamos por nombre: abre el producto en Cyberpuerta y copia su código (SKU) o el enlace de la página.";
    } else {
      const tiendaPendiente = tiendaNoPublicada(normalized);
      if (tiendaPendiente) {
        resultado = "tienda_no_publicada";
        error = `Rastreamos ${tiendaPendiente}, pero su historial todavía no está disponible en el sitio. Por ahora solo puedes consultar Cyberpuerta.`;
      } else if (!hostPertenece(normalized, "cyberpuerta.mx")) {
        resultado = "tienda_desconocida";
        error = "Por ahora solo tenemos historial de Cyberpuerta.";
      } else if (!normalized.includes("/")) {
        resultado = "sin_ruta";
        error =
          "Ese es el enlace de la portada de Cyberpuerta. Pega el de un producto.";
      } else {
        const resolved = await resolveProductUrl("cyberpuerta", normalized);
        if (resolved.ok) {
          return Astro.redirect(
            `/cyberpuerta/${encodeURIComponent(resolved.sku)}`,
            302,
          );
        }
        resultado =
          resolved.reason === "upstream_error"
            ? "error_upstream"
            : "no_encontrado";
        error =
          resolved.reason === "upstream_error"
            ? "No pudimos consultar el catálogo con ese enlace en este momento. Prueba con el código del producto: aparece como SKU en su página de Cyberpuerta."
            : "No encontramos ese producto en nuestro catálogo de Cyberpuerta.";
      }
    }
  } finally {
    // En `finally` porque los caminos exitosos salen por `return Astro.redirect(...)`: sin
    // esto, justo las búsquedas que funcionan serían las que no se registran.
    // Mismo emisor que /api/event (#24): una sola forma de evento en los logs.
    // En `sku` y `url`, `resultados` es 1 si se redirige a una ficha y 0 si no; en
    // `sku` el redirect no comprueba que la ficha exista, así que cuenta
    // propuestas, no aciertos.
    const evento = validateEvent({
      evento: "buscar",
      props: {
        modo,
        resultados: resultado === "redirigido" ? 1 : 0,
        resultado,
        ms: Date.now() - t0,
      },
    });
    if (evento) {
      logEvent(evento);
      await storeEvent(Astro.locals?.runtime, evento);
    }
    // Solo valores internos, nunca `q`. Si aparece, RESULTADOS_BUSCAR y los
    // literales de este archivo se desincronizaron (CR PR #31, H5).
    else
      console.warn(
        JSON.stringify({ t: "evt_invalid", evento: "buscar", modo, resultado }),
      );
  }
}
---

<Base
  title="Buscar producto — PrecioReal.mx"
  description="Pega el código o el enlace de un producto de Cyberpuerta y consulta su historial de precios."
>
  <div class="container page">
    <h1>Buscar producto</h1>
    <p class="sub">
      Consulta el historial de precios de un producto de Cyberpuerta con su
      código o el enlace de su página.
    </p>
    <SearchBox value={q} error={error} />
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--sp-4);
    max-width: 720px;
    padding-top: var(--sp-7);
  }
  h1 {
    font-size: var(--fs-32);
    font-weight: 700;
  }
  .sub {
    color: var(--muted);
  }
</style>
