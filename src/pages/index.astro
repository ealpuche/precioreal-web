---
// Prerenderizada (ADR-001): no lee el feed. Las cifras de cobertura vienen de `lib/site.ts`
// y la portada no muestra precios que se congelarían hasta el siguiente deploy (#40).
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import Symbol from "../components/Symbol.astro";
import { COBERTURA, FICHA_EJEMPLO, TELEGRAM_URL } from "../lib/site";

const ejemploHref = `/${FICHA_EJEMPLO.tienda}/${encodeURIComponent(FICHA_EJEMPLO.slug)}`;
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Historial de precios · {COBERTURA.tienda}</p>
        <h1>¿Ese descuento es real?</h1>
        <p class="lede">
          Pega el código o el enlace de un producto y mira cuánto costó de
          verdad en los últimos 90 días, antes de la “oferta”.
        </p>
        <SearchBox variant="hero" />
        <p class="coverage">
          Más de <span class="num">{COBERTURA.productos}</span> productos de {
            COBERTURA.tienda
          } con historial diario. Otras tiendas, todavía no.
        </p>
      </div>
      <a class="card example" href={ejemploHref}>
        <span class="eyebrow">Ejemplo de ficha</span>
        <span class="example-name">{FICHA_EJEMPLO.nombre}</span>
        <ul>
          <li>Si el precio de hoy está debajo, en o arriba de su habitual.</li>
          <li>El precio habitual junto al de hoy, para comparar.</li>
          <li>Cada cambio de precio, con su fecha.</li>
        </ul>
        <span class="example-cta">Ver su historial →</span>
      </a>
    </div>
  </section>

  <section class="container section" aria-labelledby="leer">
    <h2 id="leer">Cómo leer el veredicto</h2>
    <ul class="legend">
      <li>
        <span class="chip good">Debajo de su precio habitual</span>
        <p>
          Hoy cuesta menos que su precio habitual de los últimos 90 días. Ese sí
          es un descuento.
        </p>
      </li>
      <li>
        <span class="chip neutral">En su precio habitual</span>
        <p>
          El precio de siempre. Si la tienda lo anuncia como oferta, el tachado
          no cuenta la historia completa.
        </p>
      </li>
      <li>
        <span class="chip warn">Arriba de su precio habitual</span>
        <p>Pagarías más que de costumbre. Te decimos cuánto.</p>
      </li>
    </ul>
  </section>

  <section class="container section" aria-labelledby="telegram">
    <div class="card secondary">
      <Symbol size={40} />
      <div>
        <h2 id="telegram">¿Prefieres que las ofertas te lleguen?</h2>
        <p>
          En el canal de Telegram publicamos cada día las bajadas que sí son
          reales según su historial.
        </p>
      </div>
      <a
        class="btn btn-secondary"
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener">Abrir @precioreal_mx</a
      >
    </div>
    <p class="b2b">
      ¿Necesitas estos datos para tu negocio? <a href="/datos"
        >Datos para negocios</a
      >
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: var(--sp-7) 0 var(--sp-6);
  }
  .hero-grid {
    display: grid;
    gap: var(--sp-6);
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      gap: var(--sp-7);
    }
  }
  .hero-copy {
    display: grid;
    gap: var(--sp-4);
  }
  h1 {
    font-size: var(--fs-40);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  @media (min-width: 720px) {
    h1 {
      font-size: var(--fs-56);
    }
  }
  .lede {
    font-size: var(--fs-18);
    color: var(--muted);
    max-width: 52ch;
  }
  .coverage {
    font-size: var(--fs-14);
    color: var(--muted);
  }
  .example {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
    color: var(--text);
    text-decoration: none;
    border-left: 4px solid var(--accent);
  }
  .example:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .example-name {
    font-weight: 600;
    font-size: var(--fs-18);
    line-height: 1.3;
  }
  .example ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--muted);
    font-size: var(--fs-14);
    display: grid;
    gap: var(--sp-1);
  }
  .example-cta {
    color: var(--accent);
    font-weight: 600;
  }
  .section {
    display: grid;
    gap: var(--sp-4);
    padding-top: var(--sp-6);
  }
  h2 {
    font-size: var(--fs-24);
    font-weight: 700;
  }
  .legend {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .legend li {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .legend p {
    font-size: var(--fs-14);
    color: var(--muted);
  }
  .chip {
    width: fit-content;
    font-family: var(--mono);
    font-size: var(--fs-12);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 3px;
  }
  .chip.good {
    background: var(--down-wash);
    color: var(--down);
  }
  .chip.warn {
    background: var(--up-wash);
    color: var(--up);
  }
  .chip.neutral {
    background: var(--bg);
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .secondary {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-5);
    align-items: center;
  }
  @media (min-width: 720px) {
    .secondary {
      grid-template-columns: auto 1fr auto;
    }
  }
  .secondary h2 {
    font-size: var(--fs-20);
  }
  .secondary p {
    color: var(--muted);
    font-size: var(--fs-14);
    margin-top: var(--sp-1);
  }
  .b2b {
    font-size: var(--fs-14);
    color: var(--muted);
  }
</style>
