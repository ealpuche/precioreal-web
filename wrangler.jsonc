// Solo para desarrollo local (platformProxy). NO añadir "pages_build_output_dir":
// eso haría que Pages use esta configuración en producción en vez de la del dashboard,
// donde viven TURNSTILE_SECRET y el binding real de SUBSCRIBERS. Ver ADR-001.
{
  "name": "precioreal-web",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    {
      // Namespace de DESARROLLO, nunca el de producción: una prueba local con un correo ya
      // suscrito sobrescribiría su subscribed_at real. preview_id apunta al mismo para que
      // ninguna ruta de ejecución resuelva al namespace productivo (CR #4, H2).
      "binding": "SUBSCRIBERS",
      "id": "336f084771d84a53878a09b5d5fffb1b",
      "preview_id": "336f084771d84a53878a09b5d5fffb1b",
    },
  ],
  "d1_databases": [
    {
      // Base de DESARROLLO, nunca la de producción (mismo criterio que SUBSCRIBERS).
      // En `astro dev` el binding apunta a una base local simulada sin la tabla `events`:
      // la escritura falla, queda `evt_store_error` en consola y la página responde igual.
      "binding": "EVENTS_DB",
      "database_name": "precioreal-events-dev",
      "database_id": "e59b612c-c110-430d-9fef-e0abec0c82ba",
    },
  ],
  "r2_buckets": [
    {
      // Catálogo por binding (#67). Bucket SIMULADO en local (.wrangler/state), nunca el de
      // producción (precioreal-public): el nombre -dev no existe en la cuenta ni hace falta.
      // Arranca vacío, así que en `astro dev` las fichas dan 404 y el sitemap 503 hasta
      // sembrarlo (README → Local). Para leer el feed real por HTTP, comenta este bloque.
      "binding": "CATALOG",
      "bucket_name": "precioreal-public-dev",
    },
  ],
}
